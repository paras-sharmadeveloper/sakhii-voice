# Installed by deploy/setup.sh and deploy/update.sh.
[Unit]
Description=Sakhii voice engine (Exotel -> STT -> LLM -> TTS)
After=network-online.target redis.service redis-server.service
Wants=network-online.target

[Service]
User=sakhii
WorkingDirectory=/opt/sakhii-voice/app
EnvironmentFile=/opt/sakhii-voice/shared/.env
# Loopback only: Apache is the public entry point.
ExecStart=/opt/sakhii-voice/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --loop uvloop --http httptools --ws websockets \
    --ws-ping-interval 20 --ws-ping-timeout 20 --no-access-log
# A restart ends live calls (uvicorn closes open WebSockets) and refuses new
# ones for the few seconds it takes to come back.
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
