# Template unit: one instance per port, sakhii-voice@8000 and sakhii-voice@8001.
# The web server balances calls across both, and deploys restart them one at
# a time, so no call is ever dropped or refused.
[Unit]
Description=Sakhii voice engine on 127.0.0.1:%i
After=network-online.target redis.service redis-server.service
Wants=network-online.target

[Service]
User=sakhii
WorkingDirectory=/opt/sakhii-voice/current
EnvironmentFile=/opt/sakhii-voice/shared/.env
# Loopback only: the web server (Apache/nginx) is the public entry point.
# One asyncio process per instance (many calls each); shared state lives in
# Redis. For more CPU cores, add instances (ports) to the balancer.
ExecStart=/opt/sakhii-voice/current/.venv/bin/python -m app.serve --host 127.0.0.1 --port %i
# On stop (app/serve.py): the port closes at once, so the web server sends
# new calls to the other instance; live calls continue until they end, up to
# DRAIN_TIMEOUT_SECS (615 s, longer than the 600 s max call).
KillSignal=SIGTERM
TimeoutStopSec=630
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
