# Bootstrap: the only values this file must have are REDIS_HOST/PORT/PASSWORD/DB,
# REDIS_KEY_PREFIX and SAKHII_VOICE_CRED_KEY (plus HOST/PORT). Everything else
# can be set from the Sakhii admin panel (Redis, hot-reloaded); a value set
# there wins over this file. Values here are the fallback. README, "Settings".

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Shared secret in the Voicebot URL. Exotel drops query strings, so the flow
# uses the path form: wss://voice.YOURDOMAIN.com/ws/exotel/<this>
# (/ws/exotel?token=<this> also works, for curl and tools). URL-safe only,
# e.g. `openssl rand -hex 24`.
# Leave empty only for local testing.
EXOTEL_WS_TOKEN=
# If set, the "start" event's account_sid must match.
EXOTEL_ACCOUNT_SID=

# --- Redis (same instance Laravel uses) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Older form, used only when REDIS_HOST is empty:
# REDIS_URL=redis://127.0.0.1:6379/0
# Laravel prefixes keys with REDIS_PREFIX (default "<app-name-slug>-database-").
# Set this to the same value so both sides read/write the same keys.
REDIS_KEY_PREFIX=

# --- Provider keys (.env fallback; an agent's credential_id overrides) ---
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Google (STT, TTS, Gemini on Vertex): service-account JSON inline or a file path.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=asia-south1

# --- Laravel admin ---
# Bearer token for GET /catalog. Empty = /catalog is off (404).
ENGINE_ADMIN_TOKEN=
# Decrypts sakhii:voice:cred:<id>. base64 of 32 bytes (`openssl rand -base64 32`);
# must be the same value as in Laravel.
SAKHII_VOICE_CRED_KEY=

# --- Call recording (agents with recording_enabled) ---
# S3-compatible: AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO.
# Empty bucket/key/secret = recording off.
RECORDING_S3_ENDPOINT=
RECORDING_S3_BUCKET=
RECORDING_S3_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_REGION=auto
RECORDING_S3_PREFIX=recordings/
# Public/CDN base for recording_url. Empty = private bucket, only recording_key is sent.
RECORDING_PUBLIC_BASE_URL=
RECORDING_MP3_KBPS=32

# --- After-call analysis (summary, outcome, sentiment, fields) ---
ANALYSIS_ENABLED=true
ANALYSIS_MODEL=gpt-4o-mini

# --- Turn taking (latency vs. cutting people off) ---
# Silence after speech before the turn is evaluated. Raise (e.g. 0.3-0.5) if
# Hindi/Hinglish callers get cut off mid-sentence; every 100 ms adds 100 ms
# to each reply.
VAD_STOP_SECS=0.2
# Speech needed before the VAD reports that the caller started talking.
VAD_START_SECS=0.2
VAD_CONFIDENCE=0.7
# smart = local Smart Turn v3 model judges each pause (~10-60 ms on CPU)
# off   = a fixed silence of USER_SPEECH_TIMEOUT ends the turn
TURN_DETECTION=smart
# smart: how long to wait when the model thinks the caller isn't finished.
SMART_TURN_STOP_SECS=3.0
# off: silence that ends a turn.
USER_SPEECH_TIMEOUT=0.6

# --- Barge-in (caller talking over the bot) ---
# Continuous speech needed before the bot stops talking. Shorter sounds
# (cough, "hmm", line noise) are ignored. The bot stops about
# INTERRUPT_MIN_SPEECH_SECS + VAD_STOP_SECS after the caller starts.
INTERRUPT_MIN_SPEECH_SECS=0.4
# Or this many transcribed words, if the VAD missed the speech.
INTERRUPT_MIN_WORDS=3

# On restart/deploy, how long live calls may continue before being closed.
# Keep it above the longest max call length (default 600 s).
DRAIN_TIMEOUT_SECS=615

# Hard cap on LLM reply length (tokens). Short replies = fast first audio.
LLM_MAX_TOKENS=220
